class Solution {
    public double findMedianSortedArrays(int[] nums1, int[] nums2) {
        int m = nums1.length;
        int n = nums2.length;
        int total = m + n;
        int p1 = total / 2;
        int p0 = p1 - 1;
        int i = 0, j = 0;
        int current = 0, prev = 0;
        for (int step = 0; step <= p1; step++) {
            prev = current;

            if (i < m && (j >= n || nums1[i] <= nums2[j])) {
                current = nums1[i++];
            } else {
                current = nums2[j++];
            }
        }
        if (total % 2 != 0) {
            return current;
        } else {
            return (prev + current) / 2.0;
        }
    }
}
